page {
  min-height: 100vh;
  color: #203126;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", sans-serif;
  background-color: #f5f1e7;
  background:
    radial-gradient(circle at 0% 0%, rgba(193, 212, 183, 0.42), transparent 24%),
    radial-gradient(circle at 90% 12%, rgba(211, 228, 202, 0.5), transparent 18%),
    linear-gradient(180deg, #faf6ef 0%, #f4f1e8 42%, #eef3ea 100%);
}

view,
text,
button,
input,
textarea,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
}

button::after {
  border: 0;
}
