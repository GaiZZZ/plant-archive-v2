.text-area {
  width: 100%;
  margin-top: 12rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
}

.text-area {
  min-height: 150rpx;
}

.modal-actions {
  display: flex;
  margin-top: 28rpx;
}

.modal-button {
  flex: 1;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  text-align: center;
}

.modal-button + .modal-button {
  margin-left: 16rpx;
}

.modal-button.primary {
  color: #fffdf8;
  background: #47795e;
}
