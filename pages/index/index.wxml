<view class="page-shell">
  <view class="home-hero">
    <view class="hero-copy-wrap">
      <text class="hero-greeting">For You</text>
      <text class="hero-title">识别、诊断、照顾你的植物</text>
      <text class="hero-subtitle">拍照会先识别植物，再按识别或诊断模式展示结果；是否加入我的植物由你决定。</text>
    </view>
    <image
      class="home-hero-plant"
      src="/plant-hero-cutout.png"
      mode="aspectFit"
    />
    <view class="hero-actions">
      <button class="hero-diagnosis-button" bindtap="startIdentify">识别植物</button>
      <button class="hero-ghost-button" bindtap="startDiagnose">诊断植物</button>
    </view>
  </view>

  <view class="section-tabs">
    <button class="section-tab {{activeSection == 'forYou' ? 'active' : ''}}" data-section="forYou" bindtap="switchSection">推荐</button>
    <button class="section-tab {{activeSection == 'diagnose' ? 'active' : ''}}" data-section="diagnose" bindtap="switchSection">诊断</button>
    <button class="section-tab {{activeSection == 'identify' ? 'active' : ''}}" data-section="identify" bindtap="switchSection">识别</button>
    <button class="section-tab {{activeSection == 'plants' ? 'active' : ''}}" data-section="plants" bindtap="switchSection">我的植物</button>
  </view>

  <view wx:if="{{activeSection == 'forYou'}}" class="section-panel">
    <view class="home-snapshot">
      <view class="snapshot-item">
        <text class="snapshot-value">{{homeStats.dueCount}}</text>
        <text class="snapshot-label">今日待查</text>
      </view>
      <view class="snapshot-item">
        <text class="snapshot-value">{{homeStats.watchCount}}</text>
        <text class="snapshot-label">重点观察</text>
      </view>
      <view class="snapshot-item">
        <text class="snapshot-value">{{homeStats.avgScore}}</text>
        <text class="snapshot-label">平均健康</text>
      </view>
    </view>

    <view class="section-heading">
      <text class="section-title">For You</text>
      <button class="text-link" data-section="diagnose" bindtap="switchSection">去诊断</button>
    </view>

    <view class="priority-list" wx:if="{{todayPlants.length}}">
      <view class="priority-card" wx:for="{{todayPlants}}" wx:key="id">
        <view class="priority-main">
          <text class="plant-id">{{item.id}}</text>
          <text class="priority-name">{{item.name}}</text>
          <text class="priority-focus">{{item.focus}}</text>
        </view>
        <view class="priority-actions">
          <text class="score-pill small">{{item.scoreText}}</text>
          <button class="detail-button" data-plant-id="{{item.id}}" data-mode="diagnose" bindtap="capturePlant">诊断</button>
        </view>
      </view>
    </view>
    <view wx:else class="empty-state">今天没有需要优先查看的植物。</view>

    <view class="diagnosis-result" wx:if="{{diagnosisResult}}">
      <image wx:if="{{diagnosisPhoto}}" class="diagnosis-image" src="{{diagnosisPhoto}}" mode="aspectFill" />
      <view class="result-body">
        <text class="result-status">{{diagnosisResult.status}}</text>
        <text class="result-title">{{diagnosisResult.title}}</text>
        <view class="result-stat-row">
          <view class="result-stat" wx:for="{{diagnosisResult.resultStats}}" wx:key="label">
            <text class="result-stat-value">{{item.value}}</text>
            <text class="result-stat-label">{{item.label}}</text>
          </view>
        </view>

        <view class="result-section">
          <text class="result-label">{{diagnosisResult.identify.label}}</text>
          <text class="result-section-title">{{diagnosisResult.identify.title}}</text>
          <text class="result-summary">{{diagnosisResult.identify.copy}}</text>
          <view class="candidate-list" wx:if="{{diagnosisResult.candidateMatches.length}}">
            <view
              class="candidate-item {{item.id == selectedCandidateId ? 'selected' : ''}}"
              wx:for="{{diagnosisResult.candidateMatches}}"
              wx:key="id"
              data-plant-id="{{item.id}}"
              bindtap="selectCandidateMatch"
            >
              <view class="candidate-main">
                <text class="candidate-name">{{item.name}}</text>
                <text class="candidate-family">{{item.family}}</text>
              </view>
              <text class="candidate-confidence">{{item.confidenceText}}</text>
            </view>
          </view>
        </view>

        <view class="result-section">
          <text class="result-label">识别结果</text>
          <text class="result-section-title">{{diagnosisResult.identify.title}}</text>
          <text class="result-summary">{{diagnosisResult.identify.copy}}</text>
          <view class="candidate-list" wx:if="{{diagnosisResult.candidateMatches.length}}">
            <view
              class="candidate-item {{item.id == selectedCandidateId ? 'selected' : ''}}"
              wx:for="{{diagnosisResult.candidateMatches}}"
              wx:key="id"
              data-plant-id="{{item.id}}"
              bindtap="selectCandidateMatch"
            >
              <view class="candidate-main">
                <text class="candidate-name">{{item.name}}</text>
                <text class="candidate-family">{{item.family}}</text>
              </view>
              <text class="candidate-confidence">{{item.confidenceText}}</text>
            </view>
          </view>
        </view>
        <view class="result-section">
          <text class="result-label">{{diagnosisResult.diagnose.label}}</text>
          <text class="result-section-title">{{diagnosisResult.diagnose.title}}</text>
          <text class="result-summary">{{diagnosisResult.diagnose.copy}}</text>
          <view class="issue-list" wx:if="{{diagnosisResult.healthIssues.length}}">
            <view class="issue-item" wx:for="{{diagnosisResult.healthIssues}}" wx:key="title">
              <view class="issue-heading">
                <text class="issue-title">{{item.title}}</text>
                <text class="issue-severity">{{item.severity}}</text>
              </view>
              <text class="issue-summary">{{item.summary}}</text>
              <text class="issue-action">{{item.action}}</text>
            </view>
          </view>
        </view>

        <view class="result-section">
          <text class="result-label">{{diagnosisResult.carePlan.label}}</text>
          <text class="result-section-title">{{diagnosisResult.carePlan.title}}</text>
          <view class="action-list">
            <text class="action-item" wx:for="{{diagnosisResult.carePlan.items}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
        <view wx:if="{{pendingCapture}}" class="save-target-panel">
          <text class="save-target-label">归档到</text>
          <picker mode="selector" range="{{saveTargetLabels}}" value="{{saveTargetIndex}}" bindchange="onSaveTargetChange">
            <view class="save-target-picker">{{selectedSaveTargetLabel}}</view>
          </picker>
          <text class="save-target-copy">识别结果会保留在这次记录里，保存目标可以按实际植物调整。</text>
          <view class="result-decision-row">
            <button class="save-result-button" bindtap="savePendingCapture">{{diagnosisResult.saveText}}</button>
            <button class="result-secondary-button" bindtap="discardPendingCapture">不保存</button>
            <button class="result-secondary-button" bindtap="retakePendingCapture">重拍</button>
          </view>
        </view>
        <view wx:else class="result-saved-panel"><text class="result-saved-copy">结果已进入 {{savedPlantName}} 档案。</text><button class="view-detail-button" bindtap="openSavedPlantDetail">查看植物档案</button></view>
      </view>
    </view>

    <view class="home-collection-preview">
      <view class="home-progress-row">
        <text class="home-progress-main">My Plants {{collectionStats.collected}} / {{collectionStats.total}}</text>
        <text class="home-progress-sub">{{collectionStats.progressText}}</text>
      </view>
      <view class="collection-progress home">
        <view class="collection-progress-bar" style="width: {{collectionStats.progressPercent}};"></view>
      </view>
      <view class="preview-plant-row">
        <button
          class="preview-plant-library-card {{entry.locked ? 'locked' : ''}}"
          wx:for="{{plantPreview}}"
          wx:for-item="entry"
          wx:key="code"
          data-section="plants"
          bindtap="switchSection"
        >
          <image class="preview-plant-library-image" src="{{entry.cover}}" mode="aspectFit" />
          <text class="preview-plant-library-name">{{entry.name}}</text>
          <text class="preview-plant-state">{{entry.locked ? '未加入' : '已加入'}}</text>
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{activeSection == 'diagnose'}}" class="section-panel">
    <view class="scan-panel diagnose">
      <text class="toolbar-title">Diagnose</text>
      <text class="scan-title">拍下异常叶片，先识别再诊断</text>
      <text class="scan-copy">不需要先加入我的植物。诊断完成后，你可以选择保存到植物档案。</text>
      <button class="scan-button" bindtap="startDiagnose">开始诊断</button>
    </view>

    <view class="priority-list">
      <view class="priority-card" wx:for="{{todayPlants}}" wx:key="id">
        <view class="priority-main">
          <text class="plant-id">{{item.id}}</text>
          <text class="priority-name">{{item.name}}</text>
          <text class="priority-focus">{{item.focus}}</text>
        </view>
        <view class="priority-actions">
          <text class="score-pill small">{{item.scoreText}}</text>
          <button class="detail-button" data-plant-id="{{item.id}}" data-mode="diagnose" bindtap="capturePlant">拍照</button>
        </view>
      </view>
    </view>

    <view class="diagnosis-result" wx:if="{{diagnosisResult}}">
      <image wx:if="{{diagnosisPhoto}}" class="diagnosis-image" src="{{diagnosisPhoto}}" mode="aspectFill" />
      <view class="result-body">
        <text class="result-status">{{diagnosisResult.status}}</text>
        <text class="result-title">{{diagnosisResult.title}}</text>
        <view class="result-stat-row">
          <view class="result-stat" wx:for="{{diagnosisResult.resultStats}}" wx:key="label">
            <text class="result-stat-value">{{item.value}}</text>
            <text class="result-stat-label">{{item.label}}</text>
          </view>
        </view>
        <view class="result-section">
          <text class="result-label">{{diagnosisResult.diagnose.label}}</text>
          <text class="result-section-title">{{diagnosisResult.diagnose.title}}</text>
          <text class="result-summary">{{diagnosisResult.diagnose.copy}}</text>
          <view class="issue-list" wx:if="{{diagnosisResult.healthIssues.length}}">
            <view class="issue-item" wx:for="{{diagnosisResult.healthIssues}}" wx:key="title">
              <view class="issue-heading">
                <text class="issue-title">{{item.title}}</text>
                <text class="issue-severity">{{item.severity}}</text>
              </view>
              <text class="issue-summary">{{item.summary}}</text>
              <text class="issue-action">{{item.action}}</text>
            </view>
          </view>
        </view>
        <view class="result-section">
          <text class="result-label">{{diagnosisResult.carePlan.label}}</text>
          <text class="result-section-title">{{diagnosisResult.carePlan.title}}</text>
          <view class="action-list">
            <text class="action-item" wx:for="{{diagnosisResult.carePlan.items}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
        <view wx:if="{{pendingCapture}}" class="save-target-panel">
          <text class="save-target-label">归档到</text>
          <picker mode="selector" range="{{saveTargetLabels}}" value="{{saveTargetIndex}}" bindchange="onSaveTargetChange">
            <view class="save-target-picker">{{selectedSaveTargetLabel}}</view>
          </picker>
          <text class="save-target-copy">识别结果会保留在这次记录里，保存目标可以按实际植物调整。</text>
          <view class="result-decision-row">
            <button class="save-result-button" bindtap="savePendingCapture">{{diagnosisResult.saveText}}</button>
            <button class="result-secondary-button" bindtap="discardPendingCapture">不保存</button>
            <button class="result-secondary-button" bindtap="retakePendingCapture">重拍</button>
          </view>
        </view>
        <view wx:else class="result-saved-panel"><text class="result-saved-copy">结果已进入 {{savedPlantName}} 档案。</text><button class="view-detail-button" bindtap="openSavedPlantDetail">查看植物档案</button></view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeSection == 'identify'}}" class="section-panel">
    <view class="scan-panel identify">
      <text class="toolbar-title">Identify</text>
      <text class="scan-title">拍照识别植物，再决定是否加入</text>
      <text class="scan-copy">识别结果可以只看百科；点“加入我的植物”后，才会进入植物库和成长档案。</text>
      <button class="scan-button" bindtap="startIdentify">开始识别</button>
    </view>

    <view class="preview-plant-row identify-preview">
      <button
        class="preview-plant-library-card {{entry.locked ? 'locked' : ''}}"
        wx:for="{{plantPreview}}"
        wx:for-item="entry"
        wx:key="code"
        data-plant-id="{{entry.plantId}}"
        data-mode="identify"
        bindtap="capturePlant"
      >
        <image class="preview-plant-library-image" src="{{entry.cover}}" mode="aspectFit" />
        <text class="preview-plant-library-name">{{entry.name}}</text>
        <text class="preview-plant-state">{{entry.locked ? '未加入' : '已加入'}}</text>
      </button>
    </view>

    <view class="diagnosis-result" wx:if="{{diagnosisResult}}">
      <image wx:if="{{diagnosisPhoto}}" class="diagnosis-image" src="{{diagnosisPhoto}}" mode="aspectFill" />
      <view class="result-body">
        <text class="result-status">{{diagnosisResult.status}}</text>
        <text class="result-title">{{diagnosisResult.title}}</text>
        <view class="result-stat-row">
          <view class="result-stat" wx:for="{{diagnosisResult.resultStats}}" wx:key="label">
            <text class="result-stat-value">{{item.value}}</text>
            <text class="result-stat-label">{{item.label}}</text>
          </view>
        </view>
        <view class="result-section">
          <text class="result-label">{{diagnosisResult.identify.label}}</text>
          <text class="result-section-title">{{diagnosisResult.identify.title}}</text>
          <text class="result-summary">{{diagnosisResult.identify.copy}}</text>
          <view class="candidate-list" wx:if="{{diagnosisResult.candidateMatches.length}}">
            <view
              class="candidate-item {{item.id == selectedCandidateId ? 'selected' : ''}}"
              wx:for="{{diagnosisResult.candidateMatches}}"
              wx:key="id"
              data-plant-id="{{item.id}}"
              bindtap="selectCandidateMatch"
            >
              <view class="candidate-main">
                <text class="candidate-name">{{item.name}}</text>
                <text class="candidate-family">{{item.family}}</text>
              </view>
              <text class="candidate-confidence">{{item.confidenceText}}</text>
            </view>
          </view>
        </view>
        <view class="result-section">
          <text class="result-label">{{diagnosisResult.carePlan.label}}</text>
          <text class="result-section-title">{{diagnosisResult.carePlan.title}}</text>
          <view class="action-list">
            <text class="action-item" wx:for="{{diagnosisResult.carePlan.items}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
        <view wx:if="{{pendingCapture}}" class="save-target-panel">
          <text class="save-target-label">归档到</text>
          <picker mode="selector" range="{{saveTargetLabels}}" value="{{saveTargetIndex}}" bindchange="onSaveTargetChange">
            <view class="save-target-picker">{{selectedSaveTargetLabel}}</view>
          </picker>
          <text class="save-target-copy">识别结果会保留在这次记录里，保存目标可以按实际植物调整。</text>
          <view class="result-decision-row">
            <button class="save-result-button" bindtap="savePendingCapture">{{diagnosisResult.saveText}}</button>
            <button class="result-secondary-button" bindtap="discardPendingCapture">不保存</button>
            <button class="result-secondary-button" bindtap="retakePendingCapture">重拍</button>
          </view>
        </view>
        <view wx:else class="result-saved-panel"><text class="result-saved-copy">结果已进入 {{savedPlantName}} 档案。</text><button class="view-detail-button" bindtap="openSavedPlantDetail">查看植物档案</button></view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeSection == 'plants'}}" class="section-panel">
    <view class="collection-summary">
      <view class="collection-summary-top">
        <view>
          <text class="toolbar-title">我的植物</text>
          <text class="collection-summary-title">已加入 {{collectionStats.collected}} / {{collectionStats.total}}</text>
        </view>
        <text class="collection-progress-text">{{collectionStats.progressText}}</text>
      </view>
      <view class="collection-progress">
        <view class="collection-progress-bar" style="width: {{collectionStats.progressPercent}};"></view>
      </view>
      <view class="collection-stats">
        <view class="collection-stat">
          <text class="collection-stat-value">{{collectionStats.collected}}</text>
          <text class="collection-stat-label">已加入</text>
        </view>
        <view class="collection-stat">
          <text class="collection-stat-value">{{collectionStats.checkins}}</text>
          <text class="collection-stat-label">拍照打卡</text>
        </view>
        <view class="collection-stat">
          <text class="collection-stat-value">{{collectionStats.albumText}}</text>
          <text class="collection-stat-label">成长相册</text>
        </view>
      </view>
    </view>

    <view class="toolbar">
      <view class="toolbar-panel filter-panel">
        <text class="toolbar-title">我的植物库</text>
        <view class="filter-row">
          <button
            wx:for="{{filterItems}}"
            wx:key="code"
            class="filter-chip {{item.active ? 'active' : ''}}"
            data-family="{{item.code}}"
            bindtap="onFamilyTap"
          >
            {{item.label}}
          </button>
        </view>
        <text class="summary-line">{{plantLibrarySummary}}</text>
      </view>
    </view>

    <view class="plant-library-grid" wx:if="{{plantLibraryEntries.length}}">
      <view
        class="plant-library-card {{entry.locked ? 'locked' : ''}}"
        wx:for="{{plantLibraryEntries}}"
        wx:for-item="entry"
        wx:key="code"
      >
        <button
          class="plant-library-image-wrap"
          data-plant-id="{{entry.plantId}}"
          bindtap="capturePlant"
        >
          <image
            class="plant-library-image"
            src="{{entry.cover}}"
            mode="aspectFit"
          />
          <text class="plant-library-badge" style="background: {{entry.color}};">{{entry.code}}</text>
          <text class="plant-library-state">{{entry.locked ? '未加入' : '已加入'}}</text>
        </button>

        <view class="plant-library-body">
          <text class="plant-library-name">{{entry.name}}</text>
          <text class="plant-library-status">{{entry.statusText}}</text>
          <text class="plant-library-members">{{entry.speciesText}}</text>
          <view class="plant-library-meta-row">
            <text class="plant-library-meta">{{entry.memberText}}</text>
            <text class="plant-library-meta">{{entry.albumText}}</text>
          </view>
          <view class="plant-library-actions">
            <button
              class="detail-button"
              data-plant-id="{{entry.plantId}}"
              bindtap="openDetailPage"
            >
              档案
            </button>
            <button
              class="edit-button"
              data-plant-id="{{entry.plantId}}"
              bindtap="capturePlant"
            >
              {{entry.locked ? '识别加入' : '打卡'}}
            </button>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-state">当前筛选条件下没有植物库条目。</view>
  </view>

  <view class="settings-panel">
    <view>
      <text class="settings-title">本地档案</text>
      <text class="settings-copy">编辑内容只保存在当前微信客户端，可随时清空本地修改。</text>
    </view>
    <view class="settings-actions">
      <button class="privacy-button" bindtap="openPrivacyPage">隐私说明</button>
      <button class="reset-button" bindtap="resetLocalArchive">清空本地修改</button>
    </view>
  </view>
</view>

<view wx:if="{{modalOpen}}" class="modal-shell" catchtap="closeEditModal">
  <view class="modal-panel" catchtap="noop">
    <view class="modal-header">
      <view>
        <text class="modal-label">Edit Plant Record</text>
        <text class="modal-title">{{editModel.name}}</text>
        <text class="modal-subtitle">{{editModel.id}} / {{editModel.family}}。植物特征收在这里查看。</text>
      </view>
      <button class="modal-button" bindtap="closeEditModal">关闭</button>
    </view>

    <view class="modal-insight">
      <text class="modal-label">植物特征</text>
      <view class="modal-insight-grid">
        <view class="modal-insight-item">
          <text class="modal-label">Personality</text>
          <text class="modal-insight-value">{{editModel.personality}}</text>
        </view>
        <view class="modal-insight-item">
          <text class="modal-label">Light</text>
          <text class="modal-insight-value">{{editModel.light}}</text>
        </view>
        <view class="modal-insight-item">
          <text class="modal-label">Watering</text>
          <text class="modal-insight-value">{{editModel.watering}}</text>
        </view>
      </view>
    </view>

    <view class="modal-field">
      <text class="modal-label">Status Score</text>
      <input
        class="text-input"
        type="digit"
        value="{{editModel.score}}"
        data-field="score"
        bindinput="onEditInput"
      />
    </view>

    <view class="modal-field">
      <text class="modal-label">Stage</text>
      <input
        class="text-input"
        value="{{editModel.stage}}"
        data-field="stage"
        bindinput="onEditInput"
      />
    </view>

    <view class="modal-field">
      <text class="modal-label">Focus</text>
      <textarea
        class="text-area"
        value="{{editModel.focus}}"
        data-field="focus"
        bindinput="onEditInput"
      />
    </view>

    <view class="modal-field">
      <text class="modal-label">Note</text>
      <textarea
        class="text-area"
        value="{{editModel.note}}"
        data-field="note"
        bindinput="onEditInput"
      />
    </view>

    <view class="modal-actions">
      <button class="modal-button" bindtap="closeEditModal">取消</button>
      <button class="modal-button primary" bindtap="submitEdit">保存修改</button>
    </view>
  </view>
</view>
