<view class="page-shell">
  <view class="home-hero">
    <view class="hero-copy-wrap">
      <text class="hero-greeting">Plant Pokédex</text>
      <text class="hero-title">拍照点亮你的植物图鉴</text>
      <text class="hero-subtitle">{{heroSubtitle}}</text>
    </view>
    <image
      class="home-hero-plant"
      src="/plant-hero-morning.jpg"
      mode="aspectFit"
    />
    <button class="hero-diagnosis-button" bindtap="startAiDiagnosis">拍照打卡</button>
  </view>

  <view class="section-tabs">
    <button class="section-tab {{activeSection == 'today' ? 'active' : ''}}" data-section="today" bindtap="switchSection">今日</button>
    <button class="section-tab {{activeSection == 'collection' ? 'active' : ''}}" data-section="collection" bindtap="switchSection">图鉴</button>
    <button class="section-tab {{activeSection == 'capture' ? 'active' : ''}}" data-section="capture" bindtap="switchSection">拍照</button>
  </view>

  <view wx:if="{{activeSection == 'today'}}" class="section-panel">
    <view class="dashboard-grid compact">
      <button
        wx:for="{{dashboardCards}}"
        wx:key="label"
        class="dashboard-card {{item.focusMode ? 'dashboard-card-filter' : ''}} {{item.active ? 'active' : ''}}"
        data-focus-mode="{{item.focusMode}}"
        bindtap="onDashboardTap"
      >
        <text class="dashboard-label">{{item.label}}</text>
        <text class="dashboard-value">{{item.value}}</text>
      </button>
    </view>

    <view class="brief-card">
      <text class="toolbar-title">今日判断</text>
      <text class="brief-copy">{{heroBriefing}}</text>
    </view>

    <view class="section-heading">
      <text class="section-title">优先查看</text>
      <button class="text-link" data-section="collection" bindtap="switchSection">我的图鉴</button>
    </view>

    <view class="priority-list" wx:if="{{todayPlants.length}}">
      <view class="priority-card" wx:for="{{todayPlants}}" wx:key="id">
        <view class="priority-main">
          <text class="plant-id">{{item.id}}</text>
          <text class="priority-name">{{item.name}}</text>
          <text class="priority-focus">{{item.focus}}</text>
        </view>
        <view class="priority-actions">
          <text class="score-pill small">{{item.scoreText}}</text>
          <button class="detail-button" data-plant-id="{{item.id}}" bindtap="capturePlant">打卡</button>
        </view>
      </view>
    </view>
    <view wx:else class="empty-state">今天没有需要优先查看的植物。</view>
  </view>

  <view wx:if="{{activeSection == 'capture'}}" class="section-panel">
    <view class="diagnosis-card">
      <view class="diagnosis-copy">
        <text class="toolbar-title">拍照打卡</text>
        <text class="diagnosis-title">给一盆植物拍一张近照</text>
        <text class="diagnosis-text">第一次拍照会点亮图鉴；之后每次拍照都会进入这盆植物的生命周期档案，并生成一张 AI 养护策略占位卡。</text>
      </view>
    </view>

    <view class="capture-list">
      <view class="capture-card" wx:for="{{capturePlants}}" wx:key="id">
        <view class="capture-main">
          <text class="plant-id">{{item.id}}</text>
          <text class="capture-name">{{item.name}}</text>
          <text class="capture-meta">{{item.collected ? '已点亮' : '未收集'}} · {{item.momentCount}} 次打卡</text>
        </view>
        <button class="capture-button" data-plant-id="{{item.id}}" bindtap="capturePlant">拍照</button>
      </view>
    </view>

    <view class="diagnosis-result" wx:if="{{diagnosisResult}}">
      <image wx:if="{{diagnosisPhoto}}" class="diagnosis-image" src="{{diagnosisPhoto}}" mode="aspectFill" />
      <view class="result-body">
        <text class="result-status">{{diagnosisResult.status}}</text>
        <text class="result-title">{{diagnosisResult.title}}</text>
        <text class="result-summary">{{diagnosisResult.summary}}</text>
        <view class="action-list">
          <text class="action-item" wx:for="{{diagnosisResult.actions}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="diagnosis-result placeholder" wx:else>
      <text class="result-title">打卡结果会显示在这里</text>
      <text class="result-summary">照片会保存到该植物详情页的生命周期时间线。真实 AI 接入后，这里会生成健康判断、可能原因和接下来几天的养护策略。</text>
    </view>
  </view>

  <view wx:if="{{activeSection == 'collection'}}" class="section-panel">
    <view class="toolbar">
      <view class="toolbar-panel filter-panel">
        <text class="toolbar-title">我的植物图鉴</text>
        <view class="filter-row">
          <button
            wx:for="{{filterItems}}"
            wx:key="code"
            class="filter-chip {{item.active ? 'active' : ''}}"
            data-family="{{item.code}}"
            bindtap="onFamilyTap"
          >
            {{item.label}}
          </button>
        </view>
        <text class="summary-line">{{filterSummary}}</text>
      </view>

      <view class="toolbar-panel sort-panel">
        <text class="toolbar-title">排序</text>
        <picker
          mode="selector"
          range="{{sortOptions}}"
          range-key="label"
          value="{{sortIndex}}"
          bindchange="onSortChange"
        >
          <view class="sort-select">{{sortLabel}}</view>
        </picker>
      </view>
    </view>

    <view class="family-stack" wx:if="{{groupedPlants.length}}">
      <view class="family-section" wx:for="{{groupedPlants}}" wx:key="code">
        <view class="family-header">
          <view class="family-title-wrap">
            <text class="family-code" style="background: {{item.color}};">{{item.code}}</text>
            <text class="family-title">{{item.name}}</text>
          </view>
          <text class="family-count">{{item.items.length}} plants</text>
        </view>

        <view class="cards-grid">
          <view class="plant-card" wx:for="{{item.items}}" wx:for-item="plant" wx:key="id">
            <button
              class="cover-area"
              data-plant-id="{{plant.id}}"
              bindtap="capturePlant"
            >
              <image
                wx:if="{{plant.cover}}"
                class="cover-image"
                src="{{plant.cover}}"
                mode="aspectFill"
              />
              <view wx:else class="cover-placeholder">
                <text class="cover-icon">+</text>
                <text class="cover-title">拍照点亮图鉴</text>
                <text class="cover-subtitle">记录它的第一天</text>
              </view>
              <text wx:if="{{plant.cover}}" class="cover-action">{{plant.momentCount}} 次打卡</text>
            </button>

            <view class="card-top">
              <view class="card-title-group">
                <text class="plant-id">{{plant.id}}</text>
                <text class="plant-name">{{plant.name}}</text>
                <text class="collection-state">{{plant.collected ? '已点亮图鉴' : '未收集 · 拍第一张点亮'}}</text>
              </view>
              <button
                class="detail-button"
                data-plant-id="{{plant.id}}"
                bindtap="openDetailPage"
              >
                详情
              </button>
              <button
                class="edit-button"
                data-plant-id="{{plant.id}}"
                bindtap="capturePlant"
              >
                打卡
              </button>
              <button
                class="edit-button"
                data-plant-id="{{plant.id}}"
                bindtap="openEditModal"
              >
                编辑
              </button>
            </view>

            <view class="score-row">
              <view class="score-meter">
                <view class="score-meter-bar" style="width: {{plant.scorePercent}};"></view>
              </view>
              <text class="score-pill">{{plant.scoreText}}</text>
            </view>

            <view class="kv-list">
              <view class="kv-row">
                <text class="kv-key">stage:</text>
                <text class="kv-value">{{plant.stage}}</text>
              </view>
              <view class="kv-row">
                <text class="kv-key">focus:</text>
                <text class="kv-value">{{plant.focus}}</text>
              </view>
              <view class="kv-row">
                <text class="kv-key">last:</text>
                <text class="kv-value">{{plant.lastMomentSummary}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-state">当前筛选条件下没有植物数据。</view>
  </view>

  <view class="settings-panel">
    <view>
      <text class="settings-title">本地档案</text>
      <text class="settings-copy">编辑内容只保存在当前微信客户端，可随时清空本地修改。</text>
    </view>
    <view class="settings-actions">
      <button class="privacy-button" bindtap="openPrivacyPage">隐私说明</button>
      <button class="reset-button" bindtap="resetLocalArchive">清空本地修改</button>
    </view>
  </view>
</view>

<view wx:if="{{modalOpen}}" class="modal-shell" catchtap="closeEditModal">
  <view class="modal-panel" catchtap="noop">
    <view class="modal-header">
      <view>
        <text class="modal-label">Edit Plant Record</text>
        <text class="modal-title">{{editModel.name}}</text>
        <text class="modal-subtitle">{{editModel.id}} / {{editModel.family}}。植物特征收在这里查看。</text>
      </view>
      <button class="modal-button" bindtap="closeEditModal">关闭</button>
    </view>

    <view class="modal-insight">
      <text class="modal-label">植物特征</text>
      <view class="modal-insight-grid">
        <view class="modal-insight-item">
          <text class="modal-label">Personality</text>
          <text class="modal-insight-value">{{editModel.personality}}</text>
        </view>
        <view class="modal-insight-item">
          <text class="modal-label">Light</text>
          <text class="modal-insight-value">{{editModel.light}}</text>
        </view>
        <view class="modal-insight-item">
          <text class="modal-label">Watering</text>
          <text class="modal-insight-value">{{editModel.watering}}</text>
        </view>
      </view>
    </view>

    <view class="modal-field">
      <text class="modal-label">Status Score</text>
      <input
        class="text-input"
        type="digit"
        value="{{editModel.score}}"
        data-field="score"
        bindinput="onEditInput"
      />
    </view>

    <view class="modal-field">
      <text class="modal-label">Stage</text>
      <input
        class="text-input"
        value="{{editModel.stage}}"
        data-field="stage"
        bindinput="onEditInput"
      />
    </view>

    <view class="modal-field">
      <text class="modal-label">Focus</text>
      <textarea
        class="text-area"
        value="{{editModel.focus}}"
        data-field="focus"
        bindinput="onEditInput"
      />
    </view>

    <view class="modal-field">
      <text class="modal-label">Note</text>
      <textarea
        class="text-area"
        value="{{editModel.note}}"
        data-field="note"
        bindinput="onEditInput"
      />
    </view>

    <view class="modal-actions">
      <button class="modal-button" bindtap="closeEditModal">取消</button>
      <button class="modal-button primary" bindtap="submitEdit">保存修改</button>
    </view>
  </view>
</view>
