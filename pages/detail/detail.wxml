<view class="detail-shell" wx:if="{{plant}}">
  <view class="detail-hero">
    <image
      wx:if="{{plant.cover}}"
      class="detail-cover"
      src="{{plant.cover}}"
      mode="aspectFill"
    />
    <view wx:else class="detail-cover detail-cover-empty">
      <text class="empty-mark">{{plant.code}}</text>
      <text class="empty-copy">暂无封面</text>
    </view>

    <view class="detail-title-block">
      <text class="plant-id">{{plant.id}}</text>
      <text class="plant-name">{{plant.name}}</text>
      <view class="family-row">
        <text class="family-code" style="background: {{familyColor}};">{{plant.code}}</text>
        <text class="family-name">{{plant.family}}</text>
      </view>
      <view class="archive-stat-row">
        <view class="archive-stat">
          <text class="archive-stat-value">{{archiveStats.photoCount}}</text>
          <text class="archive-stat-label">成长照片</text>
        </view>
        <view class="archive-stat">
          <text class="archive-stat-value">{{archiveStats.latestMode}}</text>
          <text class="archive-stat-label">最近记录</text>
        </view>
        <view class="archive-stat">
          <text class="archive-stat-value">{{plant.scoreText}}</text>
          <text class="archive-stat-label">健康分</text>
        </view>
      </view>
    </view>
  </view>

  <view class="score-panel">
    <view class="score-heading">
      <text class="panel-label">Status Score</text>
      <text class="score-value">{{plant.scoreText}}</text>
    </view>
    <view class="score-meter">
      <view class="score-meter-bar" style="width: {{scorePercent}};"></view>
    </view>
    <text class="stage-text">{{plant.stage}}</text>
    <view class="detail-actions">
      <button class="detail-action primary" bindtap="chooseCover">拍照打卡</button>
      <button class="detail-action" bindtap="goHomeForEdit">回首页编辑</button>
    </view>
  </view>

  <view class="strategy-panel">
    <view class="strategy-header">
      <view>
        <text class="panel-label">AI Care Plan</text>
        <text class="panel-title">{{careStrategy.title}}</text>
      </view>
      <text class="strategy-level">{{careStrategy.level}}</text>
    </view>
    <text class="strategy-reason">{{careStrategy.reason}}</text>
    <view class="strategy-next-row">
      <text class="strategy-next-label">下次复查</text>
      <text class="strategy-next-date">{{careStrategy.nextCheck}}</text>
    </view>
    <view class="strategy-action-list">
      <text class="strategy-action" wx:for="{{careStrategy.actions}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="album-panel">
    <view class="album-header">
      <view>
        <text class="panel-label">Growth Album</text>
        <text class="panel-title">成长相册</text>
      </view>
      <button class="album-capture-button" bindtap="chooseCover">继续拍照</button>
    </view>
    <scroll-view wx:if="{{albumPhotos.length}}" class="album-scroll" scroll-x="true">
      <view class="album-track">
        <view class="album-photo-card" wx:for="{{albumPhotos}}" wx:key="id">
          <image class="album-photo" src="{{item.photo}}" mode="aspectFill" />
          <text class="album-date">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="album-empty">
      <text class="timeline-summary">还没有成长照片。第一次拍照后，它会成为这株植物的相册封面。</text>
    </view>
  </view>

  <view class="info-panel">
    <text class="panel-title">植物百科方案</text>
    <view class="info-item">
      <text class="panel-label">植物性格</text>
      <text class="info-value">{{plant.personality}}</text>
    </view>
    <view class="info-item">
      <text class="panel-label">光照偏好</text>
      <text class="info-value">{{plant.light}}</text>
    </view>
    <view class="info-item">
      <text class="panel-label">浇水方案</text>
      <text class="info-value">{{plant.watering}}</text>
    </view>
  </view>

  <view class="info-panel">
    <text class="panel-title">当前养护重点</text>
    <view class="info-item">
      <text class="panel-label">Focus</text>
      <text class="info-value">{{plant.focus}}</text>
    </view>
    <view class="info-item">
      <text class="panel-label">Note</text>
      <text class="info-value">{{plant.note}}</text>
    </view>
  </view>

  <view class="timeline-panel">
    <view class="timeline-header">
      <view>
        <text class="panel-label">Lifecycle</text>
        <text class="panel-title">生命周期档案</text>
      </view>
      <text class="timeline-count">{{moments.length}} 次打卡</text>
    </view>

    <view class="timeline-list" wx:if="{{moments.length}}">
      <view class="timeline-item" wx:for="{{moments}}" wx:key="id">
        <image wx:if="{{item.photo}}" class="timeline-photo" src="{{item.photo}}" mode="aspectFill" />
        <view class="timeline-body">
          <text class="timeline-date">{{item.displayDate}} · {{item.indexText}}</text>
          <view class="history-meta-row">
            <text class="history-mode">{{item.modeLabel}}</text>
            <text class="history-health">{{item.healthLevel}}</text>
          </view>
          <text class="history-identify">识别：{{item.identifiedName}}</text>
          <view class="history-result-row">
            <text class="history-result-chip">可信度 {{item.confidenceText}}</text>
            <text class="history-result-chip">健康分 {{item.scoreText}}</text>
          </view>
          <view class="history-candidate-list" wx:if="{{item.candidateMatches.length}}">
            <text class="history-candidate-title">识别候选</text>
            <view class="history-candidate" wx:for="{{item.candidateMatches}}" wx:key="id">
              <text class="history-candidate-name">{{item.name}}</text>
              <text class="history-candidate-score">{{item.confidenceText}}</text>
            </view>
          </view>
          <view class="history-issue-list" wx:if="{{item.healthIssues.length}}">
            <text class="history-candidate-title">健康问题</text>
            <view class="history-issue" wx:for="{{item.healthIssues}}" wx:key="title">
              <view class="history-issue-heading">
                <text class="history-issue-title">{{item.title}}</text>
                <text class="history-issue-severity">{{item.severity}}</text>
              </view>
              <text class="history-issue-action">{{item.action}}</text>
            </view>
          </view>
          <text class="timeline-summary">{{item.summary}}</text>
          <text class="timeline-advice">{{item.advice}}</text>
          <view class="history-actions" wx:if="{{item.careItems.length}}">
            <text class="history-action" wx:for="{{item.careItems}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="timeline-empty">
      <text class="timeline-summary">还没有生命周期记录。给它拍第一张照片，就会留下第一次养护档案。</text>
      <button class="detail-action primary" bindtap="chooseCover">拍第一张</button>
    </view>
  </view>
</view>

<view wx:else class="not-found">
  <text>没有找到这盆植物。</text>
</view>
